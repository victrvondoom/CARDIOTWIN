# CardioTwin unified environment template.
# Copy to .env and fill in values. Secret and credential values are blank on purpose.

# --- cardio-engineering/core/.env.example ---
LLM_PROVIDER=openrouter                      # local dev default; flip to "bedrock" for AWS deploys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.anthropic.claude-sonnet-4-6-20251022-v1:0
BEDROCK_HAIKU_MODEL_ID=apac.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
BEDROCK_KB_ID=
GENAI_GATEWAY_ENABLED=true                   # leave true unless debugging the underlying client
DATABASE_URL=
CARDIOTWIN_GLOBAL_LIVE_SOURCES=
CARDIOTWIN_GLOBAL_CURATOR_ORGS=
REDIS_URL=
TRIZETTO_GATEWAY_URL=
TRIZETTO_GATEWAY_TOKEN=
USE_AMAZON_Q=false
AMAZON_Q_APPLICATION_ID=
AMAZON_Q_INDEX_ID=
AMAZON_Q_REGION=us-east-1
EMBEDDING_MODEL=
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=dev
JWT_SECRET=
JWT_ALGORITHM=HS256
PASSPORT_SIGNING_KEY=
JWT_EXPIRE_MINUTES=10080                     # 7 days for demo convenience
DEMO_USER_PASSWORD=
USE_BEDROCK_KB=false
SEED_ON_BOOT=false
PLATFORM_ADMIN_USER_IDS=
HITL_CONFIDENCE_THRESHOLD=0.0
ONCOTWIN_LLM_EXPLANATIONS=0
AUTH_DBLESS_DEMO_ENABLED=false
TRACK7_POSTGRES_PASSWORD=
INTEROP_RECEIVER_TOKEN=
VITE_SMART_FHIR_BASE=
VITE_SMART_CLIENT_ID=
VITE_SMART_REDIRECT_URI=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@clincase.health
WEB_PUSH_ENCRYPTION_KEY=
CLOUD_DOCUMENT_PROCESSING_ENABLED=false

# --- cardio-engineering/modules/aortavision-3d/backend/.env.example ---
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# --- cardio-engineering/modules/aortavision-3d/frontend/.env.example ---
VITE_API_URL=http://localhost:8000

# --- cardio-engineering/modules/axxess/.env.example ---
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# --- cardio-engineering/modules/cad-detection-3d-heart/.env.example ---
DEBUG=True
MODEL_ARTIFACTS_DIR=backend/model_artifacts
DATASET_PATH=docs/extention of Z-Alizadeh sani dataset.xlsx
ENABLE_SHAP_EXPLANATIONS=True
SHAP_MAX_DISPLAY_FEATURES=10
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE=CardioVista - 3D CAD Risk Visualization
VITE_3D_MODEL_PATH=/models/heart-scan.glb

# --- cardio-engineering/modules/cardiotwin/frontend/.env.example ---
VITE_API_PROXY=http://localhost:8000
VITE_API_HEALTH_TIMEOUT_MS=1500

# --- cardio-engineering/modules/hack-ireland-2025/little-blue-booth/.env.example ---
AUTH_SECRET=

# --- cardio-engineering/modules/safetyconnect/.env.example ---
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_VOICE_MODEL=grok-voice-latest
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=safetyconnect
OPENFDA_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_URL=http://localhost:3000
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- pulse/.env.example ---
VITE_MOSS_PROJECT_ID=your_project_id_here
VITE_MOSS_PROJECT_KEY=
VITE_HIDEVS_LLM_URL=https://llm.hidevs.xyz/v1/chat/completions
VITE_HIDEVS_LLM_KEY=
VITE_HIDEVS_LLM_MODEL=gemini-3.5-flash-lite
