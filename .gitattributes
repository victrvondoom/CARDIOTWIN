cardio-engineering/modules/cardiovascular-risk-viz-and-prediction/**/* text=auto eol=lf

# --- from cardio-engineering/modules/cortwin/.gitattributes ---
# Byte-exact artifacts: hash-asserted files must never be EOL-converted by git.
# Contract-pinned sha256 values (manifest, CHECKSUMS.txt, model.json provenance)
# are computed over raw bytes; Windows autocrlf previously corrupted
# results.json in HEAD (D-18). `-text` stores/checks-out these paths verbatim.
cardio-engineering/modules/cortwin/**/results.json -text
cardio-engineering/modules/cortwin/**/model.json -text
cardio-engineering/modules/cortwin/web/public/*.json -text
cardio-engineering/modules/cortwin/web/public/models/*.glb -text
cardio-engineering/modules/cortwin/config/*.json -text
cardio-engineering/modules/cortwin/data/raw/** -text
cardio-engineering/modules/cortwin/data/CHECKSUMS.txt -text
cardio-engineering/modules/cortwin/assets/ready/*.glb -text
cardio-engineering/modules/cortwin/tests/fixtures/** -text
cardio-engineering/modules/cortwin/pipeline/artifacts/** -text

# --- from cardio-engineering/modules/multimodal-hackathon-track-a/.gitattributes ---
# Keep third-party and binary artefacts byte-exact on every platform: js/deps.js pins the vendored files by
# sha384 and the model registry verifies each pipeline's sha256, so no line-ending conversion may touch them.
cardio-engineering/modules/multimodal-hackathon-track-a/frontend/vendor/** -text
cardio-engineering/modules/multimodal-hackathon-track-a/**/*.joblib binary
cardio-engineering/modules/multimodal-hackathon-track-a/**/*.glb binary
cardio-engineering/modules/multimodal-hackathon-track-a/**/*.woff2 binary
cardio-engineering/modules/multimodal-hackathon-track-a/**/*.xlsx binary
cardio-engineering/modules/multimodal-hackathon-track-a/**/*.png binary
cardio-engineering/modules/multimodal-hackathon-track-a/**/*.pdf binary
