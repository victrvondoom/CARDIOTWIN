# Preserve imported snapshots and hash-pinned artifacts byte for byte.
* -text whitespace=cr-at-eol
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.glb binary
*.stl binary
*.ply binary
*.obj binary
*.zip binary
*.xlsx binary
*.joblib binary
*.pkl binary
*.mp4 binary
*.woff2 binary
*.psd binary

# ===== Merged from section and module files; each block is scoped to its folder =====
# --- from cardio-engineering/modules/cardioscope/.gitattributes ---
# Keep binary document bytes unchanged and avoid misleading text diffs.
cardio-engineering/modules/cardioscope/**/*.pdf binary

# --- from cardio-engineering/modules/cardioscope/artifacts/experiments/v2-lcx-rca-20261003-01/.gitattributes ---
# Python CSV exports use standard CRLF records; preserve sealed export bytes.
cardio-engineering/modules/cardioscope/artifacts/experiments/v2-lcx-rca-20261003-01/**/*.csv whitespace=cr-at-eol

